generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  STAFF
}

enum InvitationStatus {
  PENDING
  SENT
  OPENED
  RSVP_YES
  RSVP_NO
}

enum AttendanceStatus {
  VALID
  INVALID
  DUPLICATE
}

enum MediaType {
  PHOTO
  VIDEO
  AUDIO
  THUMBNAIL
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  events      Event[]
  attendances Attendance[] @relation("StaffScan")
  staffEvents StaffEvent[]

  @@map("users")
}

model Template {
  id              String   @id @default(uuid())
  name            String
  themeCode       String   @map("theme_code")
  config          Json?
  previewImageUrl String?  @map("preview_image_url")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  events Event[]

  @@map("templates")
}

model Event {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  templateId      String?  @map("template_id")
  title           String
  slug            String   @unique
  description     String?
  eventDate       DateTime @map("event_date")
  locationDetails String?  @map("location_details")
  status          String   @default("DRAFT")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  template    Template?    @relation(fields: [templateId], references: [id])
  guests      Guest[]
  invitations Invitation[]
  attendances Attendance[]
  medias      Media[]
  staffEvents StaffEvent[]

  @@index([userId])
  @@map("events")
}

model Guest {
  id             String   @id @default(uuid())
  eventId        String   @map("event_id")
  name           String
  customGreeting String?  @map("custom_greeting")
  email          String?
  phoneNumber    String?  @map("phone_number")
  category       String   @default("REGULAR")
  maxPax         Int      @default(1) @map("max_pax")
  createdAt      DateTime @default(now()) @map("created_at")

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invitation Invitation?

  @@index([eventId])
  @@map("guests")
}

model Invitation {
  id            String           @id @default(uuid())
  guestId       String           @unique @map("guest_id")
  eventId       String           @map("event_id")
  uniqueCode    String           @unique @map("unique_code")
  status        InvitationStatus @default(PENDING)
  rsvpPax       Int?             @map("rsvp_pax")
  customMessage String?          @map("custom_message")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  guest       Guest        @relation(fields: [guestId], references: [id], onDelete: Cascade)
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendances Attendance[]

  @@index([eventId])
  @@map("invitations")
}

model Attendance {
  id           String           @id @default(uuid())
  invitationId String           @unique @map("invitation_id")
  eventId      String           @map("event_id")
  scannedById  String           @map("scanned_by_id")
  scannedPax   Int              @default(1) @map("scanned_pax")
  scannedAt    DateTime         @default(now()) @map("scanned_at")
  status       AttendanceStatus @default(VALID)

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  staff      User       @relation("StaffScan", fields: [scannedById], references: [id])


  @@index([eventId])
  @@index([scannedById])
  @@map("attendances")
}

model Media {
  id        String    @id @default(uuid())
  eventId   String    @map("event_id")
  url       String
  type      MediaType @default(PHOTO)
  order     Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("medias")
}

model StaffEvent {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@map("staff_events")
}
