generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  STAFF
}

enum InvitationStatus {
  PENDING
  SENT
  OPENED
  RSVP_YES
  RSVP_NO
}

enum AttendanceStatus {
  VALID
  INVALID
  DUPLICATE
}

enum OrderStatus {
  DRAFT
  AWAITING_PAYMENT
  PAID
  IN_PROGRESS
  LIVE
  COMPLETED
  CANCELLED
}

enum MediaType {
  PHOTO
  VIDEO
  AUDIO
  THUMBNAIL
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  events       Event[]
  attendances  Attendance[]        @relation("StaffScan")
  checkIns     AttendanceCheckIn[] @relation("CheckInStaff")
  staffEvents  StaffEvent[]
  activityLogs ActivityLog[]       @relation("UserActivityLogs")

  @@map("users")
}

model Template {
  id              String   @id @default(uuid())
  name            String
  themeCode       String   @map("theme_code")
  renderer        String   @default("CODED") @db.VarChar(20)
  status          String   @default("HIDDEN") @db.VarChar(20)
  config          Json?
  previewImageUrl String?  @map("preview_image_url")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  events Event[]
  assets TemplateAsset[]

  @@map("templates")
}

model TemplateAsset {
  id         String   @id @default(uuid())
  templateId String   @map("template_id")
  slot       String   @db.VarChar(50)
  storageKey String   @map("storage_key")
  mimeType   String   @map("mime_type") @db.VarChar(100)
  order      Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  template Template @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@unique([templateId, slot, order])
  @@index([templateId])
  @@map("template_assets")
}

model Event {
  id              String             @id @default(uuid())
  userId          String             @map("user_id")
  templateId      String?            @map("template_id")
  title           String
  slug            String             @unique
  description     String?
  eventDate       DateTime           @map("event_date")
  locationDetails String?            @map("location_details")
  content         Json?
  status          String             @default("DRAFT")
  ticketStatus    TicketEventStatus  @default(DRAFT) @map("ticket_status")
  venue           String?            @db.VarChar(191)
  city            String?            @db.VarChar(120)
  category        String?            @db.VarChar(80)
  startAt         DateTime?          @map("start_at")
  endAt           DateTime?          @map("end_at")
  bannerUrl       String?            @map("banner_url") @db.VarChar(500)
  organizerName   String?            @map("organizer_name") @db.VarChar(150)
  taxRatePercent  Int                @default(0) @map("tax_rate_percent")
  taxIncluded     Boolean            @default(false) @map("tax_included")
  serviceFee      Int                @default(3000) @map("service_fee")
  activeUntil     DateTime?          @map("active_until")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  template       Template?       @relation(fields: [templateId], references: [id], onDelete: Restrict)
  guests         Guest[]
  invitations    Invitation[]
  attendances    Attendance[]
  medias         Media[]
  staffEvents    StaffEvent[]
  wishes         Wish[]
  offlineSyncOps OfflineSyncOp[]
  order          Order?
  activityLogs   ActivityLog[]   @relation("EventActivityLogs")
  ticketTiers    TicketTier[]
  ticketOrders   TicketOrder[]
  issuedTickets  IssuedTicket[]

  @@index([userId])
  @@index([ticketStatus, startAt])
  @@map("events")
}

model Guest {
  id             String   @id @default(uuid())
  eventId        String   @map("event_id")
  name           String
  customGreeting String?  @map("custom_greeting")
  email          String?
  phoneNumber    String?  @map("phone_number")
  category       String   @default("REGULAR")
  maxPax         Int      @default(1) @map("max_pax")
  tableNumber    String?  @map("table_number")
  createdAt      DateTime @default(now()) @map("created_at")

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invitation Invitation?

  @@index([eventId])
  @@map("guests")
}

model Invitation {
  id            String           @id @default(uuid())
  guestId       String           @unique @map("guest_id")
  eventId       String           @map("event_id")
  uniqueCode    String           @unique @map("unique_code")
  status        InvitationStatus @default(PENDING)
  rsvpPax       Int?             @map("rsvp_pax")
  customMessage String?          @map("custom_message")
  firstOpenedAt DateTime?        @map("first_opened_at")
  lastOpenedAt  DateTime?        @map("last_opened_at")
  openCount     Int              @default(0) @map("open_count")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  guest       Guest        @relation(fields: [guestId], references: [id], onDelete: Cascade)
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendances Attendance[]

  @@index([eventId])
  @@map("invitations")
}

model Attendance {
  id           String           @id @default(uuid())
  invitationId String           @unique @map("invitation_id")
  eventId      String           @map("event_id")
  scannedById  String           @map("scanned_by_id")
  scannedPax   Int              @default(1) @map("scanned_pax")
  scannedAt    DateTime         @default(now()) @map("scanned_at")
  status       AttendanceStatus @default(VALID)

  invitation Invitation          @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  event      Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  staff      User                @relation("StaffScan", fields: [scannedById], references: [id])
  checkIns   AttendanceCheckIn[]

  @@index([eventId])
  @@index([scannedById])
  @@map("attendances")
}

model AttendanceCheckIn {
  id           String   @id @default(uuid())
  attendanceId String   @map("attendance_id")
  scannedById  String   @map("scanned_by_id")
  scannedPax   Int      @default(1) @map("scanned_pax")
  scannedAt    DateTime @default(now()) @map("scanned_at")
  createdAt    DateTime @default(now()) @map("created_at")

  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  staff      User       @relation("CheckInStaff", fields: [scannedById], references: [id])

  @@index([attendanceId])
  @@index([scannedById])
  @@index([scannedAt])
  @@map("attendance_check_ins")
}

model Media {
  id        String    @id @default(uuid())
  eventId   String    @map("event_id")
  slot      String    @default("general") @db.VarChar(50)
  url       String
  type      MediaType @default(PHOTO)
  order     Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([eventId, slot])
  @@map("medias")
}

model StaffEvent {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@map("staff_events")
}

model Wish {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  name      String   @db.VarChar(120)
  message   String   @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([eventId, createdAt])
  @@map("wishes")
}

model OfflineSyncOp {
  id              String   @id
  eventId         String   @map("event_id")
  opType          String   @map("op_type")
  status          String
  deviceId        String?  @map("device_id")
  scannedById     String?  @map("scanned_by_id")
  clientTimestamp DateTime @map("client_timestamp")
  details         String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([eventId, createdAt])
  @@map("offline_sync_ops")
}

model Order {
  id                  String      @id @default(uuid())
  eventId             String      @unique @map("event_id")
  referenceCode       String      @unique @map("reference_code")
  clientName          String      @map("client_name")
  clientWhatsapp      String      @map("client_whatsapp")
  packageCode         String      @default("GOLD") @map("package_code")
  priceAmount         Int         @default(199000) @map("price_amount")
  status              OrderStatus @default(DRAFT)
  paidAt              DateTime?   @map("paid_at")
  paymentProofMediaId String?     @map("payment_proof_media_id")
  notes               String?     @db.Text
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([referenceCode])
  @@map("orders")
}

model ActivityLog {
  id          String   @id @default(uuid())
  actorUserId String?  @map("actor_user_id")
  actorRole   Role?    @map("actor_role")
  action      String   @db.VarChar(100)
  entityType  String   @map("entity_type") @db.VarChar(60)
  entityId    String   @map("entity_id") @db.VarChar(191)
  eventId     String?  @map("event_id")
  metadata    Json?
  ip          String?  @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at")

  actorUser User?  @relation("UserActivityLogs", fields: [actorUserId], references: [id], onDelete: SetNull)
  event     Event? @relation("EventActivityLogs", fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action])
  @@map("activity_logs")
}

enum TicketEventStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ENDED
  CANCELLED
}

enum TicketOrderStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
  REFUNDED
}

enum IssuedTicketStatus {
  ISSUED
  CHECKED_IN
  VOID
}

enum EoInquiryStatus {
  PENDING
  REVIEWED
  APPROVED
  REJECTED
}

model TicketTier {
  id           String    @id @default(uuid())
  eventId      String    @map("event_id")
  name         String    @db.VarChar(120)
  description  String?   @db.VarChar(500)
  price        Int       @default(0)
  quota        Int       @default(100)
  soldCount    Int       @default(0) @map("sold_count")
  salesStartAt DateTime? @map("sales_start_at")
  salesEndAt   DateTime? @map("sales_end_at")
  maxPerOrder  Int       @default(10) @map("max_per_order")
  benefits     Json?
  sortOrder    Int       @default(0) @map("sort_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Restrict)
  ticketOrders  TicketOrder[]
  issuedTickets IssuedTicket[]

  @@index([eventId])
  @@map("ticket_tiers")
}

model TicketOrder {
  id               String            @id @default(uuid())
  eventId          String            @map("event_id")
  tierId           String            @map("tier_id")
  orderCode        String            @unique @map("order_code") @db.VarChar(64)
  accessTokenHash  String?           @map("access_token_hash") @db.VarChar(191)
  buyerName        String            @map("buyer_name") @db.VarChar(150)
  buyerEmail       String            @map("buyer_email") @db.VarChar(191)
  buyerWhatsapp    String            @map("buyer_whatsapp") @db.VarChar(40)
  quantity         Int               @default(1)
  unitPrice        Int               @default(0) @map("unit_price")
  subtotal         Int               @default(0)
  serviceFee       Int               @default(3000) @map("service_fee")
  taxAmount        Int               @default(0) @map("tax_amount")
  totalAmount      Int               @default(0) @map("total_amount")
  paymentMethod    String            @default("QRIS") @map("payment_method") @db.VarChar(40)
  paymentReference String?           @map("payment_reference") @db.VarChar(120)
  status           TicketOrderStatus @default(PENDING)
  expiresAt        DateTime?         @map("expires_at")
  paidAt           DateTime?         @map("paid_at")
  emailCorrectedAt DateTime?         @map("email_corrected_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Restrict)
  tier          TicketTier     @relation(fields: [tierId], references: [id], onDelete: Restrict)
  issuedTickets IssuedTicket[]

  @@index([eventId, status])
  @@index([orderCode])
  @@index([buyerEmail])
  @@index([status, expiresAt])
  @@map("ticket_orders")
}

model IssuedTicket {
  id            String             @id @default(uuid())
  orderId       String             @map("order_id")
  eventId       String             @map("event_id")
  tierId        String             @map("tier_id")
  ticketCode    String             @unique @map("ticket_code") @db.VarChar(64)
  attendeeName  String             @map("attendee_name") @db.VarChar(150)
  attendeeEmail String             @map("attendee_email") @db.VarChar(191)
  status        IssuedTicketStatus @default(ISSUED)
  checkedInAt   DateTime?          @map("checked_in_at")
  checkedInBy   String?            @map("checked_in_by")
  checkedInGate String?            @map("checked_in_gate") @db.VarChar(80)
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  order       TicketOrder        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  event       Event              @relation(fields: [eventId], references: [id], onDelete: Restrict)
  tier        TicketTier         @relation(fields: [tierId], references: [id], onDelete: Restrict)
  checkInLogs TicketCheckInLog[]

  @@index([eventId, status])
  @@index([orderId])
  @@index([ticketCode])
  @@map("issued_tickets")
}

model TicketCheckInLog {
  id             String   @id @default(uuid())
  issuedTicketId String   @map("issued_ticket_id")
  eventId        String   @map("event_id")
  scannedBy      String?  @map("scanned_by")
  gateName       String   @default("Gerbang utama") @map("gate_name") @db.VarChar(80)
  result         String   @default("VALID") @db.VarChar(30)
  scannedAt      DateTime @default(now()) @map("scanned_at")

  issuedTicket IssuedTicket @relation(fields: [issuedTicketId], references: [id], onDelete: Restrict)

  @@index([eventId, scannedAt])
  @@index([issuedTicketId])
  @@map("ticket_check_in_logs")
}

model EoInquiry {
  id                String          @id @default(uuid())
  inquiryCode       String          @unique @map("inquiry_code") @db.VarChar(64)
  organizerName     String          @map("organizer_name") @db.VarChar(150)
  eventName         String          @map("event_name") @db.VarChar(191)
  category          String          @db.VarChar(80)
  estimatedAudience String          @map("estimated_audience") @db.VarChar(80)
  contactName       String?         @map("contact_name") @db.VarChar(150)
  contactEmail      String?         @map("contact_email") @db.VarChar(191)
  contactWhatsapp   String          @map("contact_whatsapp") @db.VarChar(40)
  notes             String?         @db.Text
  status            EoInquiryStatus @default(PENDING)
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("eo_inquiries")
}
