DATABASE_URL="mysql://username:password@localhost:3306/database_name"

JWT_ACCESS_SECRET=replace_with_secure_random_secret
JWT_ACCESS_EXPIRATION=12h

# web-invitation: trusted origin for postMessage preview updates (web-admin URL)
NEXT_PUBLIC_TRUSTED_ADMIN_ORIGIN=http://localhost:3001
# web-admin: exact origin of web-invitation for postMessage targetOrigin
NEXT_PUBLIC_INVITATION_ORIGIN=http://localhost:3002

PUBLIC_INVITATION_URL=http://localhost:3002

# API server (load root .env); web apps need their own .env.local or hosting env.
PORT=3000
# Server-only, shared by web-admin and web-invitation; never NEXT_PUBLIC.
INTERNAL_API_URL=http://localhost:3000
# Exact browser origin for admin write requests; no trailing slash.
WEB_ADMIN_ORIGIN=http://localhost:3001
# API only: absolute path on a persistent disk. Required in production.
# Example Windows: C:/irvite-data/media ; Linux: /var/lib/irvite/media
MEDIA_STORAGE_PATH=
# Public WhatsApp contact, international digits e.g. 62...; blank disables CTA.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Legacy fallback, optional; prefer NEXT_PUBLIC_WHATSAPP_NUMBER.
NEXT_PUBLIC_CONTACT_PHONE=
